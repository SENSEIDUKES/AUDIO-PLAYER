# Server-only OpenRouter credential used by /api/agent-scout.
# Never prefix this with VITE_: Vite variables are embedded in browser assets.
OPENROUTER_API_KEY=

# Optional server-side preset overrides.
OPENROUTER_PRESET_DEMO_SCOUT=@preset/sea-demo-scout-dev
OPENROUTER_PRESET_STUDIO_SCOUT=@preset/sea-studio-scout-dev
OPENROUTER_PRESET_MEMOIR=@preset/sea-demo-memoir-dev
