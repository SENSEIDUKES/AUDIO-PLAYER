{
    "name": "@seihouse/audio-player",
    "version": "4.0.0",
    "description": "Portable custom audio player (React + TypeScript) — zero-dependency core with optional lazy-loaded Automix beat analysis and wavesurfer.js waveforms",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/audio-player/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/audio-player/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/styles.css",
        "./reader-ui": {
            "types": "./dist/reader-ui/index.d.ts",
            "import": "./dist/reader-ui.js"
        },
        "./reader-ui/styles.css": "./dist/reader-ui.css"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "tsc && vite build",
        "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.reader-ui.config.ts && node scripts/check-bundle-size.mjs",
        "prepare": "npm run build:lib",
        "prepublishOnly": "npm run typecheck && npm run test:docs && npm run test:package",
        "preview": "vite preview --host 0.0.0.0",
        "preview:smoke": "node scripts/preview-smoke-test.mjs",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
        "lint": "eslint .",
        "lint:test-types": "node scripts/check-test-types.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:repository": "node scripts/check-repository-contract.mjs",
        "test:unit": "vitest run",
        "test:docs": "node scripts/check-documentation.mjs && tsc --noEmit -p tsconfig.examples.json",
        "test:package": "npm run build:lib && node scripts/package-smoke-test.mjs",
        "test": "npm run test:repository && npm run lint && npm run format:check && npm run typecheck && npm run test:docs && npm run test:unit && npm run test:package && npm run build && npm run preview:smoke",
        "skin:import": "node scripts/import-skin.mjs",
        "measure-loudness": "node scripts/measure-loudness.mjs"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "@seihouse/ui": "0.10.1",
        "@base-ui/react": "^1.5.0",
        "clsx": "^2.1.1",
        "react-aria-components": "^1.18.0",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "vaul": "^1.1.2",
        "tailwindcss": "^4.3.3"
    },
    "peerDependenciesMeta": {
        "@seihouse/ui": {
            "optional": true
        },
        "@base-ui/react": {
            "optional": true
        },
        "clsx": {
            "optional": true
        },
        "react-aria-components": {
            "optional": true
        },
        "tailwind-merge": {
            "optional": true
        },
        "tailwind-variants": {
            "optional": true
        },
        "vaul": {
            "optional": true
        },
        "tailwindcss": {
            "optional": true
        }
    },
    "devDependencies": {
        "@audio/decode": "^3.12.0",
        "@eslint/js": "^9.39.4",
        "@microsoft/api-extractor": "^7.58.9",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@seihouse/ui": "file:vendor/seihouse-ui-0.10.1.tgz",
        "@base-ui/react": "^1.5.0",
        "@tailwindcss/vite": "^4.3.3",
        "clsx": "^2.1.1",
        "react-aria-components": "^1.18.0",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.3",
        "vaul": "^1.1.2",
        "@types/react-virtualized-auto-sizer": "^1.0.4",
        "@types/react-window": "^1.8.8",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^5.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.2",
        "vitest": "^5.0.3"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "@vercel/firewall": "^1.2.1",
        "essentia.js": "0.1.3",
        "lucide-react": "^1.32.0",
        "react-virtualized-auto-sizer": "^2.0.3",
        "react-window": "^1.8.10",
        "wavesurfer.js": "^7.12.7",
        "zod": "^4.4.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/SENSEIDUKES/AUDIO-PLAYER.git"
    },
    "homepage": "https://github.com/SENSEIDUKES/AUDIO-PLAYER#readme",
    "bugs": {
        "url": "https://github.com/SENSEIDUKES/AUDIO-PLAYER/issues"
    },
    "keywords": [
        "audio",
        "player",
        "react",
        "typescript",
        "music",
        "web-audio",
        "automix"
    ],
    "author": "SEIHouse"
}
